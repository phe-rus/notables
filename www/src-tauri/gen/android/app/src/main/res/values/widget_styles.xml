<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="widget_today_description">Today’s plans and pinned notes</string>

    <style name="NotablesWidgetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="NotablesWidgetTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#FF1C1A17</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="NotablesWidgetDetail">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#FF6E6A64</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
