<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP is refused everywhere except the app's own media server on
     127.0.0.1 (storage/media_server.rs), which streams audiobooks and
     videos to the WebView with a per-launch secret in every address. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
