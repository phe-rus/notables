{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Notables",
  "version": "0.1.0",
  "identifier": "org.pherus.notables",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Notables",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; img-src 'self' data: blob: https: media: http://media.localhost; media-src 'self' data: blob: https: media: http://media.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost media: http://media.localhost https: wss: http://localhost:* ws://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Notes, journals, stories and books.",
    "longDescription": "Write, draw, record and publish notes, journals, stories and books that live on your device.",
    "copyright": "\u00a9 2026 Pherus",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["notables"]
      },
      "mobile": [
        {
          "scheme": ["notables"],
          "appLink": false
        }
      ]
    }
  }
}
