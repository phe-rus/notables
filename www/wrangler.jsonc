{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "notables",
  "main": "./src/server.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "notables.pherus.org", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notables-database",
      // Replace with the id printed by `wrangler d1 create notables-database`.
      "database_id": "d551662b-29d4-487a-9296-9f1bf480c472",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "notables-bucket" }],
  // Rooms where a person's devices and browsers meet (spec 0005). They pass
  // messages through and store nothing; SQLite backed, as the free plan needs.
  "durable_objects": {
    "bindings": [{ "name": "SPACE_ROOMS", "class_name": "SpaceRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SpaceRoom"] }]
}
