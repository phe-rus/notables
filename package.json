{
  "name": "notables",
  "private": true,
  "description": "Local-first notes, journals, audio stories and books \u2014 one app for iOS, Android, desktop and the web.",
  "license": "MIT",
  "packageManager": "bun@1.3.11",
  "workspaces": {
    "packages": [
      "www",
      "shared/*"
    ],
    "catalog": {
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "@types/react": "~19.2.0",
      "@types/react-dom": "~19.2.0",
      "@types/bun": "1.3.11",
      "typescript": "6.0.3",
      "yjs": "13.6.33",
      "zod": "4.6.5",
      "lexical": "0.52.0",
      "@lexical/code": "0.52.0",
      "@lexical/link": "0.52.0",
      "@lexical/list": "0.52.0",
      "@lexical/markdown": "0.52.0",
      "@lexical/react": "0.52.0",
      "@lexical/rich-text": "0.52.0",
      "@lexical/selection": "0.52.0",
      "@lexical/utils": "0.52.0",
      "@lexical/yjs": "0.52.0",
      "motion": "13.5.0"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "turbo": "2.11.5",
    "typescript": "6.0.3"
  }
}
