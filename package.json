{
  "name": "notables",
  "private": true,
  "description": "Local-first notes, journals, audio stories and books: one app for iOS, Android, desktop and the web.",
  "license": "MIT",
  "packageManager": "bun@1.3.11",
  "workspaces": {
    "packages": [
      "www",
      "packages/*"
    ],
    "catalog": {
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "@types/react": "~19.2.0",
      "@types/react-dom": "~19.2.0",
      "@types/bun": "1.3.11",
      "typescript": "6.0.3",
      "yjs": "13.6.33",
      "zod": "4.6.5",
      "lexical": "0.52.0",
      "@lexical/code": "0.52.0",
      "@lexical/html": "0.52.0",
      "@lexical/link": "0.52.0",
      "@lexical/list": "0.52.0",
      "@lexical/markdown": "0.52.0",
      "@lexical/react": "0.52.0",
      "@lexical/rich-text": "0.52.0",
      "@lexical/selection": "0.52.0",
      "@lexical/utils": "0.52.0",
      "@lexical/yjs": "0.52.0",
      "motion": "13.5.0",
      "@noble/ciphers": "2.4.0",
      "@noble/curves": "2.4.0",
      "@noble/hashes": "2.4.0",
      "uqr": "0.1.3",
      "jsqr": "1.4.0",
      "pdf-lib": "1.17.1",
      "pdfjs-dist": "6.3.289",
      "perfect-freehand": "1.2.3"
    }
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "scripts": {
    "dev": "turbo run dev",
    "android:chromeos": "bun scripts/android/chromeos.ts",
    "tauri": "bun run --cwd www tauri",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run lint && bun run typecheck && bun run test",
    "models:publish": "bun scripts/models/publish.ts",
    "store:screenshots": "bun scripts/store/screenshots.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@fontsource-variable/inter": "5.2.8",
    "playwright-core": "1.63.0",
    "turbo": "2.11.5",
    "typescript": "6.0.3"
  }
}
