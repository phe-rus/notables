{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "notables-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "NoteDocument", "class_name": "NoteDocument" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["NoteDocument"] }],
  "vars": {
    "AUTH_ISSUER": "https://account.pherus.org",
    "AUTH_AUDIENCE": "notables",
    "ALLOW_DEV_TOKENS": "false"
  },
  "env": {
    "dev": {
      "vars": {
        "AUTH_ISSUER": "",
        "AUTH_AUDIENCE": "notables",
        "ALLOW_DEV_TOKENS": "true"
      },
      "durable_objects": {
        "bindings": [{ "name": "NoteDocument", "class_name": "NoteDocument" }]
      }
    }
  }
}
