{
  "name": "@notables/sync-worker",
  "version": "0.0.0",
  "private": true,
  "description": "Real-time Yjs document sync for Notables — one Durable Object per note.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env dev --port 8788",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@notables/auth": "workspace:*",
    "@notables/core": "workspace:*",
    "partyserver": "0.5.10",
    "y-partyserver": "2.2.0",
    "yjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.144.0"
  }
}
