{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "notables-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notables",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "notables-media" }],
  "vars": {
    "AUTH_ISSUER": "https://account.pherus.org",
    "AUTH_AUDIENCE": "notables",
    "ALLOW_DEV_TOKENS": "false",
    "CORS_ORIGINS": "https://notables.pherus.org"
  },
  "env": {
    "dev": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "notables",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "notables-media" }],
      "vars": {
        "AUTH_ISSUER": "",
        "AUTH_AUDIENCE": "notables",
        "ALLOW_DEV_TOKENS": "true",
        "CORS_ORIGINS": "http://localhost:3000,http://localhost:8081,tauri://localhost"
      }
    }
  }
}
